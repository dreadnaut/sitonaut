<?xml version="1.0" encoding="UTF-8"?>
<phpunit
  beStrictAboutOutputDuringTests="true"
  colors="true"
>
  <testsuites>
    <testsuite name="default">
      <directory suffix="Test.php">tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">src</directory>
    </include>
  </source>
</phpunit>
